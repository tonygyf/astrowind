---
import type { HTMLAttributes } from 'astro/types';
import { findImage } from '~/utils/images';
import {
  getImagesOptimized,
  astroAssetsOptimizer,
  unpicOptimizer,
  isUnpicCompatible,
  type ImageProps,
} from '~/utils/images-optimization';

type Props = ImageProps;
type ImageType = {
  src: string;
  attributes: HTMLAttributes<'img'>;
};

const props = Astro.props;

if (props.alt === undefined || props.alt === null) {
  throw new Error();
}

if (typeof props.width === 'string') {
  props.width = parseInt(props.width);
}

if (typeof props.height === 'string') {
  props.height = parseInt(props.height);
}

if (!props.loading) {
  props.loading = 'lazy';
}

if (!props.decoding) {
  props.decoding = 'async';
}

const _image = await findImage(props.src);

let image: ImageType | undefined = undefined;

const getFallbackAttributes = (): HTMLAttributes<'img'> => {
  const allowed = new Set([
    'alt',
    'class',
    'id',
    'title',
    'width',
    'height',
    'loading',
    'decoding',
    'sizes',
    'style',
    'srcset',
    'fetchpriority',
  ]);

  const attributes: Record<string, unknown> = {};
  for (const [key, value] of Object.entries(props)) {
    if (value === undefined || value === null) continue;
    if (allowed.has(key) || key.startsWith('aria-') || key.startsWith('data-')) {
      attributes[key] = value;
    }
  }

  return attributes as HTMLAttributes<'img'>;
};

if (
  typeof _image === 'string' &&
  (_image.startsWith('http://') || _image.startsWith('https://')) &&
  isUnpicCompatible(_image)
) {
  try {
    image = await getImagesOptimized(_image, props, unpicOptimizer);
  } catch {
    image = { src: _image, attributes: getFallbackAttributes() };
  }
} else if (_image) {
  try {
    image = await getImagesOptimized(_image, props, astroAssetsOptimizer);
  } catch {
    if (typeof _image === 'string') {
      image = { src: _image, attributes: getFallbackAttributes() };
    }
  }
}
---

{
  !image ? (
    <Fragment />
  ) : (
    <img src={image.src} crossorigin="anonymous" referrerpolicy="no-referrer" {...image.attributes} />
  )
}
