---
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: '邮箱清单',
  description: '按月份管理邮箱账号使用情况，快速标记、筛选和查看未使用账号。',
};
---

<Layout metadata={metadata}>
  <section class="relative md:-mt-[76px] not-prose">
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6">
      <div class="pt-0 md:pt-[76px] pointer-events-none"></div>
      <div class="py-12 md:py-16">
        <div class="max-w-5xl mx-auto text-center mb-10">
          <p class="text-base text-secondary dark:text-blue-200 font-bold tracking-wide uppercase">独立管理页</p>
          <h1
            class="text-4xl sm:text-5xl font-bold leading-tighter tracking-tighter mb-4 font-heading dark:text-gray-200"
          >
            邮箱使用清单
          </h1>
          <p class="text-lg sm:text-xl text-muted dark:text-slate-300 max-w-3xl mx-auto">
            按月份记录每个邮箱号有没有使用、备注了什么用途，以及哪些账号本月还没动过。页面数据保存在浏览器本地，打开就能继续用。
          </p>
        </div>

        <div class="max-w-6xl mx-auto grid gap-6 lg:grid-cols-[1.05fr_1.95fr]">
          <aside
            class="rounded-2xl border border-slate-200/80 dark:border-slate-700 bg-white/80 dark:bg-slate-900/70 backdrop-blur p-6 shadow-sm"
          >
            <div class="flex items-center justify-between gap-3 mb-4">
              <div>
                <h2 class="text-xl font-semibold text-slate-900 dark:text-slate-100">本月概览</h2>
                <p class="text-sm text-slate-500 dark:text-slate-400">快速看哪些号还没用</p>
              </div>
              <span
                id="storageStatus"
                class="inline-flex items-center rounded-full bg-slate-100 dark:bg-slate-800 px-3 py-1 text-xs font-medium text-slate-600 dark:text-slate-300"
              >
                本地保存
              </span>
            </div>

            <div class="grid gap-3 sm:grid-cols-3 lg:grid-cols-1">
              <div
                class="rounded-xl border border-blue-100 dark:border-blue-900/60 bg-blue-50/80 dark:bg-blue-950/30 p-4"
              >
                <div class="text-sm text-blue-700 dark:text-blue-300">邮箱总数</div>
                <div id="statTotal" class="mt-1 text-3xl font-bold text-blue-900 dark:text-blue-100">0</div>
              </div>
              <div
                class="rounded-xl border border-emerald-100 dark:border-emerald-900/60 bg-emerald-50/80 dark:bg-emerald-950/30 p-4"
              >
                <div class="text-sm text-emerald-700 dark:text-emerald-300">本月已用</div>
                <div id="statUsed" class="mt-1 text-3xl font-bold text-emerald-900 dark:text-emerald-100">0</div>
              </div>
              <div
                class="rounded-xl border border-amber-100 dark:border-amber-900/60 bg-amber-50/80 dark:bg-amber-950/30 p-4"
              >
                <div class="text-sm text-amber-700 dark:text-amber-300">本月未用</div>
                <div id="statUnused" class="mt-1 text-3xl font-bold text-amber-900 dark:text-amber-100">0</div>
              </div>
            </div>

            <div class="mt-6">
              <label for="monthPicker" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-2"
                >统计月份</label
              >
              <input
                id="monthPicker"
                type="month"
                class="w-full rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 px-4 py-3 text-slate-900 dark:text-slate-100 outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20"
              />
            </div>

            <div class="mt-4">
              <label for="filterMode" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-2"
                >显示筛选</label
              >
              <select
                id="filterMode"
                class="w-full rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 px-4 py-3 text-slate-900 dark:text-slate-100 outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20"
              >
                <option value="all">全部邮箱</option>
                <option value="unused">只看本月未用</option>
                <option value="used">只看本月已用</option>
              </select>
            </div>

            <div class="mt-4">
              <label for="keywordInput" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-2"
                >搜索邮箱 / 备注</label
              >
              <input
                id="keywordInput"
                type="text"
                placeholder="比如 outlook / 注册站点 / 备用号"
                class="w-full rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 px-4 py-3 text-slate-900 dark:text-slate-100 outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20"
              />
            </div>

            <div class="mt-6 rounded-2xl bg-slate-50 dark:bg-slate-800/70 p-4">
              <h3 class="text-sm font-semibold text-slate-900 dark:text-slate-100 mb-2">使用建议</h3>
              <ul class="space-y-2 text-sm text-slate-600 dark:text-slate-300">
                <li>每个月切换一次月份，统一勾选哪些号已经用过。</li>
                <li>用备注记录“注册了什么站”或“本月用途”。</li>
                <li>切到“只看本月未用”，能很快找到还空着的号。</li>
              </ul>
            </div>
          </aside>

          <div class="space-y-6">
            <section
              class="rounded-2xl border border-slate-200/80 dark:border-slate-700 bg-white/80 dark:bg-slate-900/70 backdrop-blur p-6 shadow-sm lg:flex lg:max-h-[calc(100vh-11rem)] lg:min-h-[28rem] lg:flex-col"
            >
              <div class="flex flex-col md:flex-row md:items-end gap-4">
                <div class="flex-1">
                  <h2 class="text-xl font-semibold text-slate-900 dark:text-slate-100">新增邮箱</h2>
                  <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">
                    邮箱本身作为主记录，关联邮箱和 GitHub 可以挂在同一条下面。
                  </p>
                </div>
                <button
                  id="seedButton"
                  type="button"
                  class="inline-flex items-center justify-center rounded-xl px-4 py-3 font-medium bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-800 dark:text-slate-100 transition-colors"
                >
                  恢复预设清单
                </button>
              </div>

              <form id="emailForm" class="mt-5 grid gap-4 md:grid-cols-2">
                <div>
                  <label for="emailInput" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-2"
                    >邮箱地址</label
                  >
                  <input
                    id="emailInput"
                    name="email"
                    type="email"
                    required
                    placeholder="name@example.com"
                    class="w-full rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 px-4 py-3 text-slate-900 dark:text-slate-100 outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20"
                  />
                </div>
                <div>
                  <label for="tagInput" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-2"
                    >标签</label
                  >
                  <input
                    id="tagInput"
                    name="tag"
                    type="text"
                    placeholder="主号 / 备用 / 注册站点"
                    class="w-full rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 px-4 py-3 text-slate-900 dark:text-slate-100 outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20"
                  />
                </div>
                <div class="md:col-span-2">
                  <label for="accountsInput" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-2">
                    关联账号
                  </label>
                  <input
                    id="accountsInput"
                    name="accounts"
                    type="text"
                    placeholder="可填另一个邮箱，或 github:tonygyf，多个用 / 、逗号或空格分隔"
                    class="w-full rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 px-4 py-3 text-slate-900 dark:text-slate-100 outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20"
                  />
                </div>
                <div class="md:col-span-2">
                  <label for="noteInput" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-2"
                    >备注</label
                  >
                  <textarea
                    id="noteInput"
                    name="note"
                    rows="3"
                    placeholder="例如：本月注册 AI 站点、备用接码、只做订阅测试"
                    class="w-full rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 px-4 py-3 text-slate-900 dark:text-slate-100 outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20"
                  ></textarea>
                </div>
                <div class="md:col-span-2 flex flex-col sm:flex-row gap-3">
                  <button
                    type="submit"
                    class="inline-flex items-center justify-center rounded-xl px-5 py-3 font-medium bg-blue-600 hover:bg-blue-700 text-white transition-colors"
                  >
                    添加邮箱
                  </button>
                  <button
                    id="exportButton"
                    type="button"
                    class="inline-flex items-center justify-center rounded-xl px-5 py-3 font-medium bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-800 dark:text-slate-100 transition-colors"
                  >
                    导出 JSON
                  </button>
                  <label
                    class="inline-flex items-center justify-center rounded-xl px-5 py-3 font-medium bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-800 dark:text-slate-100 transition-colors cursor-pointer"
                  >
                    导入 JSON
                    <input id="importInput" type="file" accept="application/json" class="hidden" />
                  </label>
                </div>
              </form>
            </section>

            <section
              class="flex flex-col overflow-hidden rounded-2xl border border-slate-200/80 dark:border-slate-700 bg-white/80 dark:bg-slate-900/70 p-6 shadow-sm backdrop-blur h-[58vh] min-h-[24rem] md:h-[62vh] lg:h-[calc(100vh-12rem)] lg:min-h-[32rem]"
            >
              <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-3 mb-5">
                <div>
                  <h2 class="text-xl font-semibold text-slate-900 dark:text-slate-100">邮箱列表</h2>
                  <p id="resultSummary" class="text-sm text-slate-500 dark:text-slate-400 mt-1">正在加载邮箱数据...</p>
                </div>
                <button
                  id="clearUnusedButton"
                  type="button"
                  class="inline-flex items-center justify-center rounded-xl px-4 py-3 font-medium bg-amber-100 hover:bg-amber-200 dark:bg-amber-900/40 dark:hover:bg-amber-900/60 text-amber-900 dark:text-amber-100 transition-colors"
                >
                  清空本月未用勾选
                </button>
              </div>

              <div class="min-h-0 flex-1 overflow-y-auto overscroll-contain pr-1 md:pr-2">
                <div
                  id="emptyState"
                  class="hidden rounded-2xl border border-dashed border-slate-300 dark:border-slate-700 p-10 text-center"
                >
                  <p class="text-lg font-medium text-slate-900 dark:text-slate-100">还没有邮箱记录</p>
                  <p class="text-sm text-slate-500 dark:text-slate-400 mt-2">
                    先添加几个邮箱，或者点上面的“恢复预设清单”。
                  </p>
                </div>

                <div id="emailList" class="grid gap-4"></div>
              </div>
            </section>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script is:inline>
    (() => {
      const STORAGE_KEY = 'email-usage-tracker-v1';
      const monthPicker = document.getElementById('monthPicker');
      const filterMode = document.getElementById('filterMode');
      const keywordInput = document.getElementById('keywordInput');
      const emailForm = document.getElementById('emailForm');
      const emailInput = document.getElementById('emailInput');
      const tagInput = document.getElementById('tagInput');
      const accountsInput = document.getElementById('accountsInput');
      const noteInput = document.getElementById('noteInput');
      const emailList = document.getElementById('emailList');
      const emptyState = document.getElementById('emptyState');
      const resultSummary = document.getElementById('resultSummary');
      const statTotal = document.getElementById('statTotal');
      const statUsed = document.getElementById('statUsed');
      const statUnused = document.getElementById('statUnused');
      const storageStatus = document.getElementById('storageStatus');
      const exportButton = document.getElementById('exportButton');
      const importInput = document.getElementById('importInput');
      const seedButton = document.getElementById('seedButton');
      const clearUnusedButton = document.getElementById('clearUnusedButton');

      const today = new Date();
      const defaultMonth = `${today.getFullYear()}-${String(today.getMonth() + 1).padStart(2, '0')}`;

      const presetEmails = [
        {
          id: crypto.randomUUID(),
          email: '1563426958@qq.com',
          tag: 'QQ',
          relatedAccounts: [],
          createdAt: new Date().toISOString(),
          usage: {},
        },
        {
          id: crypto.randomUUID(),
          email: 'gyf121382026@163.com',
          tag: '163',
          relatedAccounts: [],
          createdAt: new Date().toISOString(),
          usage: {},
        },
        {
          id: crypto.randomUUID(),
          email: '1761604414@qq.com',
          tag: 'QQ',
          relatedAccounts: ['github:gyf12-alt'],
          createdAt: new Date().toISOString(),
          usage: {},
        },
        {
          id: crypto.randomUUID(),
          email: '221310213@mail.dhu.edu.cn',
          tag: '学校',
          relatedAccounts: [],
          createdAt: new Date().toISOString(),
          usage: {},
        },
        {
          id: crypto.randomUUID(),
          email: '3329438368@qq.com',
          tag: 'QQ',
          relatedAccounts: ['github:tonyqq-2'],
          createdAt: new Date().toISOString(),
          usage: {},
        },
        {
          id: crypto.randomUUID(),
          email: '3698193552@qq.com',
          tag: 'QQ',
          relatedAccounts: ['github:gyf-369-qq'],
          createdAt: new Date().toISOString(),
          usage: {},
        },
        {
          id: crypto.randomUUID(),
          email: '3301289307@qq.com',
          tag: 'QQ',
          relatedAccounts: ['github:gyf-qq-3'],
          createdAt: new Date().toISOString(),
          usage: {},
        },
        {
          id: crypto.randomUUID(),
          email: 'gt766457@gmail.com',
          tag: 'Gmail',
          relatedAccounts: ['gyf260624@gmail.com', 'github:tonygyf'],
          note: '双邮箱关联同一个 GitHub 号',
          createdAt: new Date().toISOString(),
          usage: {},
        },
        {
          id: crypto.randomUUID(),
          email: 't32713770@gmail.com',
          tag: 'Gmail',
          relatedAccounts: ['github:t32713770-create'],
          createdAt: new Date().toISOString(),
          usage: {},
        },
        {
          id: crypto.randomUUID(),
          email: 'gyf20260628@gmail.com',
          tag: 'Gmail',
          relatedAccounts: ['guot057@gmail.com'],
          note: '保留这组 Gmail 之间的关联，GitHub 账号已分别拆回对应 QQ 邮箱。',
          createdAt: new Date().toISOString(),
          usage: {},
        },
      ];

      let state = loadState();
      monthPicker.value = state.selectedMonth || defaultMonth;
      filterMode.value = state.filter || 'all';
      keywordInput.value = state.keyword || '';

      function loadState() {
        try {
          const raw = localStorage.getItem(STORAGE_KEY);
          if (!raw) {
            return { emails: presetEmails, selectedMonth: defaultMonth, filter: 'all', keyword: '' };
          }
          const parsed = JSON.parse(raw);
          return {
            emails: Array.isArray(parsed.emails)
              ? parsed.emails.map((item) => ({
                  ...item,
                  relatedAccounts: Array.isArray(item.relatedAccounts) ? item.relatedAccounts : [],
                }))
              : presetEmails,
            selectedMonth: parsed.selectedMonth || defaultMonth,
            filter: parsed.filter || 'all',
            keyword: parsed.keyword || '',
          };
        } catch (error) {
          console.error('Failed to load email usage data:', error);
          return { emails: presetEmails, selectedMonth: defaultMonth, filter: 'all', keyword: '' };
        }
      }

      function saveState() {
        try {
          localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
          storageStatus.textContent = '已自动保存';
        } catch (error) {
          console.error('Failed to save email usage data:', error);
          storageStatus.textContent = '保存失败';
        }
      }

      function escapeHtml(value) {
        return String(value ?? '')
          .replaceAll('&', '&amp;')
          .replaceAll('<', '&lt;')
          .replaceAll('>', '&gt;')
          .replaceAll('"', '&quot;')
          .replaceAll("'", '&#39;');
      }

      function currentMonth() {
        return monthPicker.value || defaultMonth;
      }

      function parseRelatedAccounts(value) {
        return String(value || '')
          .split(/[\/,，\n\r\t ]+/)
          .map((item) => item.trim())
          .filter(Boolean);
      }

      function isUsedThisMonth(item, month) {
        return Boolean(item.usage && item.usage[month] && item.usage[month].used);
      }

      function getMonthNote(item, month) {
        return item.usage && item.usage[month] ? item.usage[month].monthNote || '' : '';
      }

      function filteredEmails() {
        const month = currentMonth();
        const keyword = keywordInput.value.trim().toLowerCase();

        return state.emails.filter((item) => {
          const used = isUsedThisMonth(item, month);

          if (filterMode.value === 'used' && !used) return false;
          if (filterMode.value === 'unused' && used) return false;

          if (!keyword) return true;

          return [item.email, item.tag, item.note, getMonthNote(item, month), ...(item.relatedAccounts || [])]
            .filter(Boolean)
            .some((value) => String(value).toLowerCase().includes(keyword));
        });
      }

      function renderStats() {
        const month = currentMonth();
        const total = state.emails.length;
        const used = state.emails.filter((item) => isUsedThisMonth(item, month)).length;
        const unused = total - used;

        statTotal.textContent = String(total);
        statUsed.textContent = String(used);
        statUnused.textContent = String(unused);
      }

      function renderList() {
        const month = currentMonth();
        const items = filteredEmails();
        renderStats();

        resultSummary.textContent = `当前月份 ${month}，共显示 ${items.length} / ${state.emails.length} 个邮箱`;

        if (items.length === 0) {
          emailList.innerHTML = '';
          emptyState.classList.remove('hidden');
          return;
        }

        emptyState.classList.add('hidden');
        emailList.innerHTML = items
          .map((item) => {
            const used = isUsedThisMonth(item, month);
            const monthNote = getMonthNote(item, month);
            return `
              <article class="rounded-2xl border ${used ? 'border-emerald-200 dark:border-emerald-900/50 bg-emerald-50/50 dark:bg-emerald-950/20' : 'border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900'} p-5 shadow-sm">
                <div class="flex flex-col xl:flex-row gap-4 xl:items-start xl:justify-between">
                  <div class="min-w-0">
                    <div class="flex flex-wrap items-center gap-2">
                      <h3 class="text-lg font-semibold text-slate-900 dark:text-slate-100 break-all">${escapeHtml(item.email)}</h3>
                      ${
                        item.tag
                          ? `<span class="inline-flex items-center rounded-full bg-slate-100 dark:bg-slate-800 px-2.5 py-1 text-xs font-medium text-slate-700 dark:text-slate-300">${escapeHtml(item.tag)}</span>`
                          : ''
                      }
                      <span class="inline-flex items-center rounded-full px-2.5 py-1 text-xs font-medium ${
                        used
                          ? 'bg-emerald-100 text-emerald-800 dark:bg-emerald-900/50 dark:text-emerald-200'
                          : 'bg-amber-100 text-amber-800 dark:bg-amber-900/50 dark:text-amber-200'
                      }">
                        ${used ? '本月已用' : '本月未用'}
                      </span>
                    </div>
                    <p class="mt-2 text-sm text-slate-600 dark:text-slate-300">${escapeHtml(item.note || '暂无备注')}</p>
                    ${
                      item.relatedAccounts && item.relatedAccounts.length > 0
                        ? `
                          <div class="mt-3 flex flex-wrap gap-2">
                            ${item.relatedAccounts
                              .map(
                                (account) =>
                                  `<span class="inline-flex items-center rounded-full bg-blue-50 dark:bg-blue-900/30 px-2.5 py-1 text-xs font-medium text-blue-700 dark:text-blue-200">${escapeHtml(account)}</span>`
                              )
                              .join('')}
                          </div>
                        `
                        : ''
                    }
                  </div>

                  <div class="flex items-center gap-3">
                    <label class="inline-flex items-center gap-2 text-sm font-medium text-slate-700 dark:text-slate-300 cursor-pointer">
                      <input data-action="toggle-used" data-id="${item.id}" type="checkbox" class="h-4 w-4 rounded border-slate-300 text-blue-600 focus:ring-blue-500" ${used ? 'checked' : ''} />
                      标记已用
                    </label>
                    <button data-action="delete" data-id="${item.id}" type="button" class="rounded-lg px-3 py-2 text-sm font-medium bg-rose-100 hover:bg-rose-200 dark:bg-rose-900/40 dark:hover:bg-rose-900/60 text-rose-800 dark:text-rose-100 transition-colors">
                      删除
                    </button>
                  </div>
                </div>

                <div class="mt-4">
                  <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-2">本月备注</label>
                  <textarea data-action="month-note" data-id="${item.id}" rows="2" class="w-full rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 px-4 py-3 text-slate-900 dark:text-slate-100 outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20" placeholder="例如：本月注册了哪个网站、消耗到哪一步">${escapeHtml(monthNote)}</textarea>
                </div>
              </article>
            `;
          })
          .join('');
      }

      function upsertMonthUsage(itemId, updater) {
        const month = currentMonth();
        state.emails = state.emails.map((item) => {
          if (item.id !== itemId) return item;
          const usage = item.usage || {};
          const current = usage[month] || { used: false, monthNote: '' };
          return {
            ...item,
            usage: {
              ...usage,
              [month]: updater(current),
            },
          };
        });
        saveState();
        renderList();
      }

      emailForm.addEventListener('submit', (event) => {
        event.preventDefault();
        const email = emailInput.value.trim();
        const tag = tagInput.value.trim();
        const relatedAccounts = parseRelatedAccounts(accountsInput.value);
        const note = noteInput.value.trim();

        if (!email) return;

        const exists = state.emails.some((item) => item.email.toLowerCase() === email.toLowerCase());
        if (exists) {
          storageStatus.textContent = '该邮箱已存在';
          emailInput.focus();
          return;
        }

        state.emails.unshift({
          id: crypto.randomUUID(),
          email,
          tag,
          relatedAccounts,
          note,
          createdAt: new Date().toISOString(),
          usage: {},
        });

        saveState();
        renderList();
        emailForm.reset();
        emailInput.focus();
      });

      monthPicker.addEventListener('change', () => {
        state.selectedMonth = currentMonth();
        saveState();
        renderList();
      });

      filterMode.addEventListener('change', () => {
        state.filter = filterMode.value;
        saveState();
        renderList();
      });

      keywordInput.addEventListener('input', () => {
        state.keyword = keywordInput.value;
        saveState();
        renderList();
      });

      emailList.addEventListener('change', (event) => {
        const target = event.target;
        if (!(target instanceof HTMLElement)) return;

        if (target instanceof HTMLInputElement && target.dataset.action === 'toggle-used') {
          const id = target.dataset.id;
          if (!id) return;
          upsertMonthUsage(id, (current) => ({ ...current, used: target.checked }));
        }

        if (target instanceof HTMLTextAreaElement && target.dataset.action === 'month-note') {
          const id = target.dataset.id;
          if (!id) return;
          upsertMonthUsage(id, (current) => ({ ...current, monthNote: target.value }));
        }
      });

      emailList.addEventListener('click', (event) => {
        const target = event.target;
        if (!(target instanceof HTMLElement)) return;
        if (target.dataset.action !== 'delete') return;

        const id = target.dataset.id;
        if (!id) return;

        state.emails = state.emails.filter((item) => item.id !== id);
        saveState();
        renderList();
      });

      seedButton.addEventListener('click', () => {
        if (!window.confirm('这会用你的预设邮箱清单覆盖当前页面数据，确认继续吗？')) return;
        state.emails = presetEmails.map((item) => ({
          ...item,
          relatedAccounts: [...(item.relatedAccounts || [])],
          usage: {},
        }));
        saveState();
        renderList();
      });

      clearUnusedButton.addEventListener('click', () => {
        const month = currentMonth();
        state.emails = state.emails.map((item) => ({
          ...item,
          usage: {
            ...(item.usage || {}),
            [month]: {
              ...(item.usage?.[month] || {}),
              used: false,
            },
          },
        }));
        saveState();
        renderList();
      });

      exportButton.addEventListener('click', () => {
        const blob = new Blob([JSON.stringify(state, null, 2)], { type: 'application/json' });
        const url = URL.createObjectURL(blob);
        const link = document.createElement('a');
        link.href = url;
        link.download = `email-usage-${currentMonth()}.json`;
        document.body.appendChild(link);
        link.click();
        link.remove();
        URL.revokeObjectURL(url);
      });

      importInput.addEventListener('change', async () => {
        const file = importInput.files?.[0];
        if (!file) return;

        try {
          const text = await file.text();
          const parsed = JSON.parse(text);
          state = {
            emails: Array.isArray(parsed.emails)
              ? parsed.emails.map((item) => ({
                  ...item,
                  relatedAccounts: Array.isArray(item.relatedAccounts) ? item.relatedAccounts : [],
                }))
              : [],
            selectedMonth: parsed.selectedMonth || currentMonth(),
            filter: parsed.filter || 'all',
            keyword: '',
          };
          monthPicker.value = state.selectedMonth;
          filterMode.value = state.filter;
          keywordInput.value = '';
          saveState();
          renderList();
        } catch (error) {
          console.error('Failed to import email usage data:', error);
          storageStatus.textContent = '导入失败';
        } finally {
          importInput.value = '';
        }
      });

      renderList();
    })();
  </script>
</Layout>
