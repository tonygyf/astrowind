---
import Features2 from '~/components/widgets/Features2.astro';
import Features3 from '~/components/widgets/Features3.astro';
import Hero from '~/components/widgets/Hero.astro';
import Stats from '~/components/widgets/Stats.astro';
import Steps2 from '~/components/widgets/Steps2.astro';
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: '关于我的毕设项目',
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
    tagline="多模式智能考勤系统"
    image={{
      src: 'https://images.unsplash.com/photo-1559136555-9303baea8ebd?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2070&q=80',
      alt: '多模式智能考勤系统',
    }}
  >
    <Fragment slot="title">
      Android + Serverless 轻量考勤
    </Fragment>

    <Fragment slot="subtitle">
      GPS/二维码/人脸/手势签到，离线可用，自动防作弊，低成本零运维
    </Fragment>
  </Hero>

  <!-- Stats Widget ****************** -->

  <Stats
    title="项目统计"
    stats={[
      { title: '考勤模式', amount: '3+' },
      { title: '开发周期', amount: '6个月' },
      { title: '技术栈', amount: '5+' },
      { title: '系统功能', amount: '20+' },
    ]}
  />

  <!-- Features3 Widget ************** -->

  <Features3
    title="核心功能"
    subtitle="现代移动考勤方案，Android MVVM + SQLite 离线签到，Cloudflare Workers + D1 Serverless 后端"
    columns={3}
    isBeforeContent={true}
    items={[
      {
        title: '多模式签到',
        description:
          'GPS / 二维码 / 人脸 / 手势四种模式，灵活适配各种场景',
        icon: 'tabler:scan',
      },
      {
        title: '离线支持',
        description:
          'SQLite本地存储 + 云端同步，网络中断也能正常打卡',
        icon: 'tabler:wifi-off',
      },
      {
        title: '自动异常检测',
        description:
          '智能识别异常打卡行为，自动标记和预警',
        icon: 'tabler:shield-check',
      },
    ]}
  />

  <!-- Features3 Widget ************** -->

  <Features3
    columns={3}
    isAfterContent={true}
    items={[
      {
        title: '多角色管理',
        description:
          '学生签到 + 教师管理闭环，活动发布、异常标记、批量导入、报表导出',
        icon: 'tabler:users',
      },
      {
        title: 'Serverless 后端',
        description:
          'Cloudflare Workers + D1，低延迟、高并发、零运维，轻量部署、低成本',
        icon: 'tabler:cloud',
      },
      {
        title: '统计报表',
        description:
          '自动生成考勤统计报表，支持导出和数据分析',
        icon: 'tabler:report',
      },
      {
        title: '防作弊机制',
        description:
          '多重验证机制，确保考勤数据的真实性和准确性',
        icon: 'tabler:shield-lock',
      },
      {
        title: '高并发支持',
        description:
          '支持大规模并发访问，适合大型活动考勤',
        icon: 'tabler:bolt',
      },
      {
        title: '易部署',
        description:
          '一键部署，快速上线，无需复杂配置',
        icon: 'tabler:rocket',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1551288049-bebda4e38f71?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1740&q=80',
      alt: '数据分析图表',
    }}
  />

  <!-- 毕设项目入口 -->
  
  <Hero
    tagline="项目演示"
    image={{
      src: 'https://images.unsplash.com/photo-1460925895917-afdab827c52f?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1740&q=80',
      alt: '系统后台',
    }}
  >
    <Fragment slot="title">
      体验完整的多模式考勤系统
    </Fragment>

    <Fragment slot="subtitle">
      一款基于 Android 的智能考勤系统，支持 GPS、二维码、人脸、手势多模式签到。采用 MVVM + SQLite 实现离线可用，
      Cloudflare Workers + D1 构建 Serverless 后端，实现低延迟、高并发、零运维。
    </Fragment>

    <Fragment slot="actions">
      <a
        href="https://omni.gyf123.dpdns.org"
        target="_blank"
        class="btn btn-primary btn-lg w-full sm:w-auto"
      >
        访问毕设项目后台
      </a>
    </Fragment>
  </Hero>

  <!-- Steps2 Widget ****************** -->

  <Steps2
    title="技术架构"
    subtitle="Android MVVM + SQLite 离线签到，Cloudflare Workers + D1 Serverless 后端，低延迟、高并发、零运维"
    items={[
      {
        title: 'Android MVVM',
        description:
          '采用MVVM架构模式，代码结构清晰，易于维护和扩展',
      },
      {
        title: 'SQLite 离线存储',
        description:
          '本地数据库支持，离线状态下也能正常记录考勤数据',
      },
      {
        title: 'Serverless 架构',
        description:
          'Cloudflare Workers + D1，无需服务器运维，自动扩缩容',
      },
    ]}
  />

  <!-- Steps2 Widget ****************** -->

  <Steps2
    title="项目价值"
    subtitle="轻量部署、零运维、低成本，为企业提供高效便捷的考勤管理解决方案"
    isReversed={true}
    callToAction={{
      text: '查看项目演示',
      href: 'https://omni.gyf123.dpdns.org',
      target: '_blank'
    }}
    items={[
      {
        title: '轻量部署',
        description: '一键部署，快速上线，无需复杂配置和服务器维护',
        icon: 'tabler:rocket',
      },
      {
        title: '零运维',
        description:
          'Serverless 架构，自动扩缩容，无需专人维护服务器',
        icon: 'tabler:cloud',
      },
      {
        title: '低成本',
        description:
          '按量计费，无固定服务器成本，大幅降低企业考勤管理费用',
        icon: 'tabler:coin',
      },
    ]}
  />

  <!-- Features2 Widget ************** -->

  <Features2
    title="项目特色"
    tagline="核心优势"
    columns={2}
    items={[
      {
        title: '多模式集成',
        description: '人脸识别、指纹识别、RFID卡片三种考勤方式无缝集成',
      },
      {
        title: '智能后台',
        description: '功能完善的后台管理系统，支持数据统计分析',
      },
      {
        title: '实时响应',
        description: '考勤数据实时上传，异常情况即时预警',
      },
      {
        title: '移动友好',
        description: '响应式设计，完美适配各种设备屏幕',
      },
    ]}
  />

  <!-- Features2 Widget ************** -->

  <Features2
    title="技术支持"
    tagline="联系我们"
    columns={2}
    items={[
      {
        title: '项目演示',
        description:
          '访问在线演示系统，体验完整的多模式考勤功能',
        icon: 'tabler:external-link',
        callToAction: {
          text: '立即访问',
          href: 'https://omni.gyf123.dpdns.org',
          target: '_blank'
        }
      },
      {
        title: '源码查看',
        description:
          '查看项目源代码，了解技术实现细节',
        icon: 'tabler:brand-github',
        callToAction: {
          text: 'GitHub',
          href: 'https://github.com/tonygyf',
          target: '_blank'
        }
      },
    ]}
  />
</Layout>
