---
import Layout from '~/layouts/PageLayout.astro';

import Content from '~/components/widgets/Content.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Features3 from '~/components/widgets/Features3.astro';
import Steps from '~/components/widgets/Steps.astro';
import Image from '~/components/common/Image.astro';

const metadata = {
  title: '我的个人主页 - 软件工程学生',
};
---

<Layout metadata={metadata}>
  <Fragment slot="announcement"></Fragment>
  <!-- 
    注意：移除了原模板中的 <Fragment slot="header"> 部分，
    现在页面将自动使用 src/navigation.ts 中配置的全局导航栏。
  -->

  <!-- Hero2 Widget ******************* -->

  <section class="relative md:-mt-[76px] not-prose" id="hero">
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6">
      <div class="pt-0 md:pt-[76px] pointer-events-none"></div>
      <div class="py-12 md:py-20">
        <div class="text-center pb-10 md:pb-16 max-w-5xl mx-auto">
          <p
            class="text-base text-secondary dark:text-blue-200 font-bold tracking-wide uppercase intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade"
          >
            Java / Kotlin 开发者
          </p>
          <h1
            class="text-5xl md:text-6xl font-bold leading-tighter tracking-tighter mb-4 font-heading dark:text-gray-200 intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade"
          >
            你好，我是tonygyf
          </h1>
          <div class="max-w-3xl mx-auto">
            <p
              class="text-xl text-muted mb-6 dark:text-slate-300 intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade"
              data-gsap="subtitle"
            >
              我来自<b>东华大学</b>。<br /> 
              擅长 <b>Java</b> 和 <b>Kotlin</b> 开发，热衷于探索软件工程的最佳实践与新技术。
            </p>
            <div
              class="max-w-xs sm:max-w-md m-auto flex flex-nowrap flex-col sm:flex-row sm:justify-center gap-4 intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade"
              data-gsap="actions"
            >
              <a
                href="https://github.com/tonygyf"
                target="_blank"
                class="inline-flex items-center justify-center w-full sm:w-auto px-6 py-3 text-base font-semibold text-white rounded-lg bg-primary-600 hover:bg-primary-700 transition-colors"
              >
                <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd"></path>
                </svg>
                GitHub 主页
              </a>
            </div>
          </div>
        </div>
        <div
          class="intersect-once intersect-no-queue intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade"
        >
          <div class="relative m-auto max-w-5xl" data-gsap="hero-image">
            <Image
              src="https://githubcard.com/tonygyf.svg"
              alt="tonygyf's GitHub stats card"
              class="mx-auto rounded-md w-full"
              widths={[400, 768, 1024, 2040]}
              sizes="(max-width: 767px) 400px, (max-width: 1023px) 768px, (max-width: 2039px) 1024px, 2040px"
              loading="eager"
              width={1024}
              height={576}
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Content Widget **************** -->

  <Content
    id="about"
    columns={2}
    items={[
      {
        icon: 'tabler:photo-up',
        callToAction: {
          target: '_blank',
          text: 'Telegraph 图床',
          href: 'https://image.gyf123.dpdns.org/',
        },
        description: '免费图床，支持上传图片至 Telegram 频道，无限流量。',
      },
      {
        icon: 'tabler:device-tv',
        callToAction: {
          target: '_blank',
          text: 'LibreTV',
          href: 'https://tv.gyf123.dpdns.org/',
        },
        description: '免费在线视频搜索与观看平台，聚合多源内容。',
      },
      {
        icon: 'tabler:world',
        callToAction: {
          target: '_blank',
          text: 'VPNApp 网页',
          href: 'https://vpnapp.gyf123.dpdns.org/',
        },
        description: 'VPNApp WebView 页面，快速连接与节点展示。',
      },
      {
        icon: 'tabler:notebook',
        callToAction: {
          target: '_blank',
          text: '个人博客',
          href: 'https://blog.gyf123.dpdns.org/',
        },
        description: '基于 AstroPaper 的技术博客，分享我的学习笔记和项目心得。',
      },
    ]}
    image={{
      src: '~/assets/images/商业照.png',
      alt: '我的个人照片',
      loading: 'eager',
    }}
  >
    <Fragment slot="content">
      <h2 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">关于我</h2>
      <p>
        我是一名来自<b>上海东华大学</b>软件工程专业的在读大学生。
      </p>
      <br />
      <p>
        除了专注于 <b>Java</b> 和 <b>Kotlin</b> 开发，我也热衷于折腾服务器和搭建各类实用的网络服务。我部署了一系列个人应用来提升效率和生活质量。
      </p>
      <br />
      <p>
        在这里，你可以访问我搭建的<b>免费图床</b>、<b>在线视频平台</b>以及我的<b>技术博客</b>。欢迎体验！
      </p>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Steps Widget ****************** -->

  <Steps
    id="resume"
    title="教育背景"
    items={[
      {
        title: `软件工程 (本科) <br /> <span class="font-normal">上海东华大学</span> <br /> <span class="text-sm font-normal">2022 - 至今</span>`,
        icon: 'tabler:school',
        description: '主修课程：Java 程序设计、数据结构与算法、计算机网络、操作系统、软件工程导论等。',
      },
    ]}
    classes={{ container: 'max-w-3xl' }}
  />

  <!-- Features3 Widget ************** -->

  <Features3
    title="技能专长"
    subtitle="我在学习和实践中掌握的技术栈。"
    columns={3}
    defaultIcon="tabler:point-filled"
    items={[
      {
        title: 'Java 开发',
        description: '熟练掌握 Java 核心语法、面向对象编程思想及常用集合框架。',
      },
      {
        title: 'Kotlin 开发',
        description: '熟悉 Kotlin 语言特性，能够使用 Kotlin 进行高效的应用开发。',
      },
      {
        title: '后端技术',
        description: '了解 Spring Boot 等主流后端框架，具备 RESTful API 开发意识。',
      },
      {
        title: '数据库',
        description: '熟悉 MySQL 等关系型数据库的基本操作与 SQL 编写。',
      },
      {
        title: '开发工具',
        description: '熟练使用 IntelliJ IDEA, Git 等开发工具进行版本控制与协作。',
      },
      {
        title: '软件工程',
        description: '理解软件开发生命周期，具备良好的编码规范和文档编写习惯。',
      },
      {
        title: '算法与数据结构',
        description: '具备扎实的算法基础，能够运用常见数据结构解决问题。',
      },
      {
        title: '英语能力',
        description: '具备良好的英文技术文档阅读能力。',
      },
      {
        title: '持续学习',
        description: '对新技术保持敏感，拥有强大的自驱力和学习能力。',
      },
    ]}
  />

  <!-- Features2 Widget ************** -->

  <Features2
    id="projects"
    title="项目展示"
    subtitle="我的 GitHub 置顶开源项目"
    columns={3}
    items={[
      {
        title: 'Node Subscription Manager',
        description: '节点自用订阅管理工具，支持多种协议转换与筛选',
        icon: 'tabler:server',
        callToAction: { text: '查看源码', href: 'https://github.com/tonygyf/cmliu', icon: 'tabler:brand-github' },
      },
      {
        title: 'Screenshot to MD Note',
        description: '一个基于cursor开发，截屏后自动生成md笔记的python小应用',
        icon: 'tabler:brand-python',
        callToAction: { text: '查看源码', href: 'https://github.com/tonygyf/cursor-calculator-demo1', icon: 'tabler:brand-github' },
      },
      {
        title: 'ID Photo Generator',
        description: '使用mediapip的证件照生成器',
        icon: 'tabler:id',
        callToAction: { text: '查看源码', href: 'https://github.com/tonygyf/cursor-picture-demo2', icon: 'tabler:brand-github' },
      },
      {
        title: 'V2Ray Simple VPN',
        description: '基于 WebView 的简洁 VPN 页面，支持一键连接与节点展示',
        icon: 'tabler:shield',
        callToAction: { text: '查看源码', href: 'https://github.com/tonygyf/vpnapp', icon: 'tabler:brand-github' },
      },
      {
        title: 'Online Teach App',
        description: '仿造学习通的安卓在线教育应用，Material Design 风格',
        icon: 'tabler:school',
        callToAction: { text: '查看源码', href: 'https://github.com/tonygyf/onlineTeach', icon: 'tabler:brand-github' },
      },
      {
        title: 'P2P Call & Chat',
        description: '基于 Electron 和 WebDAV 的现代化点对点安全通话与聊天应用',
        icon: 'tabler:phone',
        callToAction: { text: '查看源码', href: 'https://github.com/tonygyf/p2p-call-webdav', icon: 'tabler:brand-github' },
      },
      {
        title: 'Full Stack Web App',
        description: '这是一个一步一步做出来的前后端分离程序 (Vue + Spring Boot)',
        icon: 'tabler:brand-vue',
        callToAction: { text: '查看源码', href: 'https://github.com/tonygyf/vue-springboot', icon: 'tabler:brand-github' },
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Features2>

  <!-- Content Widget **************** -->
  <!-- 
    如果你暂时没有更多项目，可以注释掉下面的 Content 组件，
    或者把它们改成其他的练习项目。
  -->

  <!-- Testimonials Widget *********** -->
  <!-- 暂时隐藏客户评价，因为没有工作经历 -->
  <!-- 
  <Testimonials
    title="客户评价"
    ...
  />
  -->

  <!-- CallToAction Widget *********** -->

  <CallToAction
    title="期待与您合作"
    subtitle="如果您正在寻找一名潜力无限的 Java/Kotlin 实习生，请随时联系我。"
    actions={[
      {
        variant: 'primary',
        text: '发送邮件',
        href: 'mailto:your-email@example.com',
      },
    ]}
  />

  <!-- BlogLatestPost Widget **************** -->
  <!--
  <BlogLatestPosts
    id="blog"
    title="最新博客文章"
    information={`分享我的学习笔记和技术心得。`}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </BlogLatestPosts>
  -->
</Layout>
